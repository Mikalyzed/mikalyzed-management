generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(uuid())
  clerkId        String   @unique @map("clerk_id")
  name           String
  email          String   @unique
  role           String   @default("sales")
  password       String   @default("")
  isActive       Boolean  @default(true) @map("is_active")
  // "New For You" cutoff — everything assigned after this shows in the
  // dashboard's what's-new card until the user taps Got It (which stamps it).
  dashboardSeenAt DateTime? @map("dashboard_seen_at")
  twilioNumber   String?  @unique @map("twilio_number") // E.164 format, owns inbound + outbound SMS for this rep
  emailSignature String?  @map("email_signature") // user's outlook signature — stripped from mirrored emails
  createdAt      DateTime @default(now()) @map("created_at")

  assignedVehicles      Vehicle[]                   @relation("CurrentAssignee")
  createdVehicles       Vehicle[]                   @relation("CreatedBy")
  assignedStages        VehicleStage[]              @relation("StageAssignee")
  transportRequests     TransportRequest[]          @relation("RequestedBy")
  coordinatedTransports TransportRequest[]          @relation("Coordinator")
  notifications         Notification[]
  activityLogs          ActivityLog[]
  calendarAssignments   CalendarAssignee[]
  createdCalendarItems  CalendarItem[]              @relation("CalendarCreatedBy")
  ownedEvents           Event[]                     @relation("EventOwner")
  createdEvents         Event[]                     @relation("EventCreatedBy")
  assignedEventTasks    EventTask[]                 @relation("EventTaskAssignee")
  createdContacts       Contact[]                   @relation("ContactCreatedBy")
  assignedOpps          Opportunity[]               @relation("OpportunityAssignee")
  createdNotes          OpportunityNote[]           @relation("NoteCreatedBy")
  assignedOppTasks      OpportunityTask[]           @relation("OppTaskAssignee")
  createdOppTasks       OpportunityTask[]           @relation("OppTaskCreatedBy")
  activityActions       ActivityEvent[]             @relation("ActivityActor")
  assignedTasks         Task[]                      @relation("TaskAssignee")
  createdTasks          Task[]                      @relation("TaskCreator")
  taskApprovals         TaskApproval[]
  connectedIgAccounts   ConnectedInstagramAccount[]
  requestedParts        Part[]                      @relation("PartRequestedBy")
  assignedParts         Part[]                      @relation("PartAssignedTo")
  roundRobinWeights     RoundRobinWeight[]
  dispositionLogs       DispositionLog[]
  sentMessages          Message[]                   @relation("MessageSender")
  porterEntries         PorterEntry[]               @relation("PorterEntries")
  porterTasksAssigned   PorterTask[]                @relation("PorterTaskAssignee")
  porterTasksCreated    PorterTask[]                @relation("PorterTaskCreator")
  uploadLinksCreated    UploadLink[]                @relation("UploadLinkCreator")
  emailSubscriptions    EmailSubscription[]
  calls                 Call[]
  costAddsAdded         CostAdd[]
  mediaUploaded         MediaAsset[]
  dealsAsRep            Deal[]                      @relation("DealSalesRep")
  dealsCreated          Deal[]                      @relation("DealCreatedBy")

  @@map("users")
}

model Vehicle {
  id                String    @id @default(uuid())
  stockNumber       String    @unique @map("stock_number")
  vin               String?
  year              Int?
  make              String
  model             String
  color             String?
  trim              String?
  // Deal-jacket vehicle specifics (DealerCenter Vehicle Info parity)
  engine            String?
  transmission      String?
  driveTrain        String?   @map("drive_train")
  titleBrand        String?   @map("title_brand") // Clean / Salvage / Rebuilt / ...
  newUsed           String?   @map("new_used") // New / Used
  status            String    @default("mechanic")
  currentStageId    String?   @map("current_stage_id")
  // Coordinator's routing suggestion for an awaiting_routing car — admin
  // approves (routes) or overrides; cleared on routing.
  routingProposal   Json?     @map("routing_proposal") // { stage, byId, byName, at }
  currentAssigneeId String?   @map("current_assignee_id")
  notes             String?
  createdById       String?   @map("created_by")
  returnQueue       Json      @default("[]") @map("return_queue")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  completedAt       DateTime? @map("completed_at")

  // Phase 0.A — absorbed from InventoryVehicle (all nullable for backward compat)
  vehicleInfo              String?   @map("vehicle_info")
  mileage                  Int?
  location                 String?
  askingPrice              Float?    @map("asking_price")
  vehicleCost              Float?    @map("vehicle_cost")
  purchaseType             String?   @map("purchase_type") // PURCHASED / TRADE_IN / CONSIGNMENT — Phase 0.B backfill maps legacy "FLOORING" → "PURCHASED"
  purchaseSource           String?   @map("purchase_source") // acquisition channel: auction / consignment / private_party / referral / repeat / repo / trade_in / wholesale / other
  purchasedFrom            String?   @map("purchased_from") // raw vendor name string — Vendor FK is Phase 2
  purchasedFromVendorId    String?   @map("purchased_from_vendor_id") // Partner.id when source = vendor
  purchasedFromContactId   String?   @map("purchased_from_contact_id") // Contact.id when source = customer
  titleStatus              String?   @map("title_status") // RECEIVED / NOT_RECEIVED
  dateInStock              DateTime? @map("date_in_stock")
  inventoryStatus          String?   @map("inventory_status") // in_stock / in_recon / external_repair / sold / removed / inventory_only — separate from recon `status`
  consignmentCommissionPct Float?    @map("consignment_commission_pct")

  // Phase 2 — flooring (simple inline fields; lender table + curtailment come later)
  floorLender      String?   @map("floor_lender") // e.g. "NextGear Capital"
  floorPrincipal   Float?    @map("floor_principal") // dollars advanced
  floorDailyRate   Float?    @map("floor_daily_rate") // percent per day, e.g. 0.025 means 0.025%/day
  floorAdvanceDate DateTime? @map("floor_advance_date")
  floorStatus      String?   @map("floor_status") // pending | active | paid_off

  // VIN-history dup linking (per CONTEXT dup-VIN handling)
  priorVehicleId String?   @map("prior_vehicle_id")
  priorVehicle   Vehicle?  @relation("VehiclePriorHistory", fields: [priorVehicleId], references: [id])
  laterVehicles  Vehicle[] @relation("VehiclePriorHistory")

  // Audit-trail bridges (preserved permanently per VEH-02)
  legacyInventoryVehicleId String? @map("legacy_inventory_vehicle_id")
  legacyVehicleId          String? @map("legacy_vehicle_id") // for Strategy A this equals current id, but reserved for traceability symmetry

  currentAssignee   User?              @relation("CurrentAssignee", fields: [currentAssigneeId], references: [id])
  createdBy         User?              @relation("CreatedBy", fields: [createdById], references: [id])
  stages            VehicleStage[]
  transportRequests TransportRequest[]
  calendarItems     CalendarItem[]
  opportunities     Opportunity[]      @relation("OpportunityVehicle")
  vehicleInterests  VehicleInterest[]  @relation("VehicleInterestVehicle")
  parts             Part[]
  costAdds          CostAdd[]
  mediaAssets       MediaAsset[]
  deals             Deal[]
  plan              VehiclePlan?

  @@index([status])
  @@index([currentAssigneeId])
  @@index([vin])
  @@index([inventoryStatus])
  @@index([priorVehicleId])
  @@index([legacyInventoryVehicleId])
  @@index([purchasedFromContactId])
  @@map("vehicles")
}

// Phase 3 — typed media on a vehicle (photos, videos, docs)
model MediaAsset {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  type        String   // exterior | interior | undercarriage | walkaround_video | turntable_video | other_video | doc | other
  r2Key       String   @map("r2_key")
  contentType String?  @map("content_type")
  sizeBytes   Int?     @map("size_bytes")
  filename    String?
  caption     String?
  sortOrder   Int      @default(0) @map("sort_order")
  uploadedById String  @map("uploaded_by_id")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([vehicleId])
  @@index([type])
  @@index([uploadedAt])
  @@map("media_assets")
}

// Phase 2 — itemized cost tracking that rolls into vehicle true cost
model CostAdd {
  id            String   @id @default(uuid())
  vehicleId     String   @map("vehicle_id")
  kind          String   // free-form, picked from cost_add_categories (admin-managed list) or typed
  amountCents   Int      @map("amount_cents")
  description   String?  // free-form, picked from cost_add_descriptions or typed
  vendor        String?  // legacy free-form vendor name; new rows use partnerId instead
  partnerId     String?  @map("partner_id")
  receiptUrl    String?  @map("receipt_url")
  paymentMethod String?  @map("payment_method") // fixed list (see PAYMENT_METHOD_OPTIONS)
  memo          String?
  addedById     String   @map("added_by_id")
  addedAt       DateTime @default(now()) @map("added_at")

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  addedBy User     @relation(fields: [addedById], references: [id])
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([addedAt])
  @@index([partnerId])
  @@map("cost_adds")
}

// Business entities the dealership works with — vendors, lenders, lienholders,
// insurance, repo agents, etc. One Partner can carry multiple categories; the
// `categories` array uses the canonical PARTNER_CATEGORY values defined in app code.
// AddPartnerModal on the vehicle detail page is the primary write surface.
model Partner {
  id          String   @id @default(uuid())
  categories  String[] @default([])

  // General Info
  companyName     String  @map("company_name")
  companyAlias    String? @map("company_alias")
  dealerNo        String? @map("dealer_no")
  phone           String?
  phoneAlternative String? @map("phone_alternative")
  fax             String?
  licenseNo       String? @map("license_no")
  ein             String?
  salesTaxLicense String? @map("sales_tax_license")
  lienCode        String? @map("lien_code")

  // Contact Info (primary contact person at this partner)
  contactName            String? @map("contact_name")
  contactPhone           String? @map("contact_phone")
  contactCell            String? @map("contact_cell")
  contactAddress         String? @map("contact_address")
  contactEmail           String? @map("contact_email")
  contactLossPayeeAddress String? @map("contact_loss_payee_address")
  contactAlias           String? @map("contact_alias")

  // Shipping Info
  shippingName          String? @map("shipping_name")
  shippingBusinessPhone String? @map("shipping_business_phone")
  shippingAddress       String? @map("shipping_address")

  isActive    Boolean   @default(true) @map("is_active")
  archivedAt  DateTime? @map("archived_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  costAdds        CostAdd[]
  dealLineItems   DealLineItem[]
  lienholderDeals Deal[]         @relation("DealLienholder")

  @@index([companyName])
  @@index([archivedAt])
  @@index([categories], type: Gin)
  @@map("partners")
}

// Dealership-wide list of common Cost Add description quick-picks. Admins
// manage the list; any user can free-type any value when adding a cost. The
// dropdown is a convenience, not a constraint. archived_at supports soft-delete
// so removing an option doesn't break historical references in cost_adds.description.
model CostAddDescription {
  id          String    @id @default(uuid())
  name        String    @unique
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  archivedAt  DateTime? @map("archived_at")

  @@index([archivedAt])
  @@map("cost_add_descriptions")
}

// Sibling table to CostAddDescription — same shape, same admin-managed pattern,
// holds the Category quick-pick list. Categories are stored on the cost_adds
// row as `kind` (a free-form string); this table is just the dropdown source.
model CostAddCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  archivedAt  DateTime? @map("archived_at")

  @@index([archivedAt])
  @@map("cost_add_categories")
}

model Part {
  id                   String    @id @default(uuid())
  vehicleId            String    @map("vehicle_id")
  name                 String
  url                  String?
  status               String    @default("requested") // requested, sourced, ordered, received
  requestedById        String    @map("requested_by_id")
  assignedToId         String?   @map("assigned_to_id")
  price                String?
  tracking             String?
  orderImage           String?   @map("order_image")
  expectedDelivery     DateTime? @map("expected_delivery")
  // Live carrier tracking via EasyPost (config-guarded — null when unused)
  epTrackerId          String?   @map("ep_tracker_id")
  trackingCarrier      String?   @map("tracking_carrier")
  trackingStatus       String?   @map("tracking_status") // pre_transit / in_transit / out_for_delivery / delivered / …
  trackingUpdatedAt    DateTime? @map("tracking_updated_at")
  notes                String?
  // Stamped when admin generates an "Install [part]" task in mechanic via routing.
  // Used to prevent the same install from being re-suggested in future routing cycles.
  installTaskCreatedAt DateTime? @map("install_task_created_at")
  // Where this part gets installed once it arrives, captured at request time.
  // 'external' = an outside vendor installs it (a gated ExternalRepair is created
  // now, waiting on this part); 'inhouse' = our mechanics install it (the existing
  // received → mechanic-checklist flow). null = no install planned / unknown.
  installVenue         String?   @map("install_venue")
  // Vendor name when installVenue = 'external' (e.g. "Garage 27"). Purely for
  // labels; the real link is ExternalRepair.blockedOnPartId pointing back here.
  installShop          String?   @map("install_shop")
  // The stage during which this part was added (e.g. mechanic inspection).
  // Lets the vehicle history dropdown group parts under their originating stage.
  sourceStageId        String?   @map("source_stage_id")
  // Which inspection task this part was added from (e.g. "Brake inspection").
  // Optional: only set when the part was created via the inline form on a specific task.
  sourceItem           String?   @map("source_item")
  // Which sub-field within the parent item triggered the part request (e.g. "Brake lights").
  sourceSubField       String?   @map("source_sub_field")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  requestedBy User          @relation("PartRequestedBy", fields: [requestedById], references: [id])
  assignedTo  User?         @relation("PartAssignedTo", fields: [assignedToId], references: [id])
  sourceStage VehicleStage? @relation("PartSourceStage", fields: [sourceStageId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([status])
  @@index([requestedById])
  @@index([assignedToId])
  @@index([sourceStageId])
  @@map("parts")
}

model VehicleStage {
  id                    String    @id @default(uuid())
  vehicleId             String    @map("vehicle_id")
  stage                 String
  status                String    @default("pending")
  assigneeId            String?   @map("assignee_id")
  checklist             Json      @default("[]")
  notes                 String?
  dueDate               DateTime? @map("due_date")
  scopeName             String?   @map("scope_name")
  estimatedHours        Float?    @map("estimated_hours")
  startedAt             DateTime  @default(now()) @map("started_at")
  completedAt           DateTime? @map("completed_at")
  blockedAt             DateTime? @map("blocked_at")
  totalBlockedSeconds   Int       @default(0) @map("total_blocked_seconds")
  priority              Int       @default(0)
  awaitingParts         Boolean   @default(false) @map("awaiting_parts")
  awaitingPartsDate     DateTime? @map("awaiting_parts_date")
  awaitingPartsSince    DateTime? @map("awaiting_parts_since")
  awaitingPartsName     String?   @map("awaiting_parts_name")
  awaitingPartsTracking String?   @map("awaiting_parts_tracking")
  pauseReason           String?   @map("pause_reason")
  activeSeconds         Int       @default(0) @map("active_seconds")
  timerStartedAt        DateTime? @map("timer_started_at")
  autoPaused            Boolean   @default(false) @map("auto_paused")
  pauseDetail           String?   @map("pause_detail")
  pausedAt              DateTime? @map("paused_at")
  scheduledDate         DateTime? @map("scheduled_date")
  createdAt             DateTime  @default(now()) @map("created_at")
  // Per-mechanic timers on a shared car, keyed by userId:
  //   { [userId]: { activeSeconds, timerStartedAt, autoPaused, pauseReason, pauseDetail, pausedAt } }
  // Absent/empty → fall back to the stage-level single timer above (existing cars,
  // and any car worked by just one mechanic behave exactly as before).
  timers                Json?     @map("timers")

  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignee      User?          @relation("StageAssignee", fields: [assigneeId], references: [id])
  taskApprovals TaskApproval[]
  sourcedParts  Part[]         @relation("PartSourceStage")

  @@index([vehicleId])
  @@index([assigneeId])
  @@index([stage, status])
  @@map("vehicle_stages")
}

// One row per completed work session (a mechanic's timer start → stop) on a
// mechanic-stage car. Lets us report accurate per-day / per-mechanic labor
// hours — the running `timers` map is a cumulative total and can't answer
// "how much did Paul work TODAY" once a car spans multiple days.
model MechanicTimeLog {
  id        String   @id @default(uuid())
  stageId   String   @map("stage_id")
  vehicleId String   @map("vehicle_id")
  userId    String   @map("user_id")
  seconds   Int
  startedAt DateTime @map("started_at")
  endedAt   DateTime @map("ended_at")
  workDate  String   @map("work_date") // 'YYYY-MM-DD' in ET — groups sessions by the day work happened
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, workDate])
  @@index([stageId])
  @@map("mechanic_time_logs")
}

model TransportRequest {
  id                 String    @id @default(uuid())
  vehicleId          String?   @map("vehicle_id")
  vehicleDescription String?   @map("vehicle_description")
  vin                String?
  trailerType        String?   @map("trailer_type") // enclosed, open
  clientName         String?   @map("client_name")
  clientPhone        String?   @map("client_phone")
  requestedById      String    @map("requested_by")
  pickupLocation     String    @map("pickup_location")
  deliveryLocation   String    @map("delivery_location")
  urgency            String    @default("standard")
  preferredDate      DateTime? @map("preferred_date")
  transportType      String?   @map("transport_type") // internal, third_party
  purpose            String? // event, ship_to_client, other
  purposeNote        String?   @map("purpose_note") // free text when purpose = other
  estimatedPrice     Float?    @map("estimated_price") // ship-to-client quote
  status             String    @default("requested")
  coordinatorId      String?   @map("coordinator_id")
  carrierInfo        String?   @map("carrier_info")
  scheduledDate      DateTime? @map("scheduled_date")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  requestedBy User     @relation("RequestedBy", fields: [requestedById], references: [id])
  coordinator User?    @relation("Coordinator", fields: [coordinatorId], references: [id])

  @@index([status])
  @@index([requestedById])
  @@map("transport_requests")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  type       String
  title      String
  message    String?
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// Business buyer for wholesale deals (DealerCenter "Business Deal" parity).
// A reusable list — the same dealer/LLC can buy many cars. All fields
// optional except the name; underwriting boxes included but not required.
model Business {
  id           String @id @default(uuid())
  businessName String @map("business_name")
  tradeName    String? @map("trade_name")
  enterpriseType String? @map("enterprise_type") // LLC / Corporation / ...
  taxId        String? @map("tax_id")
  yearsInBusiness  Int? @map("years_in_business")
  monthsInBusiness Int? @map("months_in_business")
  grossMonthlyIncome Float? @map("gross_monthly_income")

  street String?
  city   String?
  state  String?
  zip    String?
  county String?
  lengthAtAddressYears  Int? @map("length_at_address_years")
  lengthAtAddressMonths Int? @map("length_at_address_months")
  mortgageType String? @map("mortgage_type")
  phone  String?
  email  String?
  typeOfBusiness String? @map("type_of_business")

  // Fleet + underwriting history (optional; kept for DC parity)
  vehiclesFinanced Int?   @map("vehicles_financed")
  vehiclesOwned    Int?   @map("vehicles_owned")
  aggregateMonthlyPmt Float? @map("aggregate_monthly_pmt")
  loanLease        String? @map("loan_lease")
  operatingLease   String? @map("operating_lease")
  priorBankruptcy  String? @map("prior_bankruptcy")
  priorRepossession String? @map("prior_repossession")
  lawsuitParty     String? @map("lawsuit_party") // party to a lawsuit?
  delinquentTaxes  String? @map("delinquent_taxes")

  // Operator (runs the business day-to-day)
  operatorFirstName String? @map("operator_first_name")
  operatorLastName  String? @map("operator_last_name")
  operatorStreet    String? @map("operator_street")
  operatorCity      String? @map("operator_city")
  operatorState     String? @map("operator_state")
  operatorZip       String? @map("operator_zip")
  operatorCounty    String? @map("operator_county")

  // Principal (owner)
  principalFirstName String? @map("principal_first_name")
  principalLastName  String? @map("principal_last_name")
  principalJobTitle  String? @map("principal_job_title")
  principalPhone     String? @map("principal_phone")
  principalDob       DateTime? @map("principal_dob")
  principalOwnershipPct Float? @map("principal_ownership_pct")
  principalStreet    String? @map("principal_street")
  principalCity      String? @map("principal_city")
  principalState     String? @map("principal_state")
  principalZip       String? @map("principal_zip")
  principalCounty    String? @map("principal_county")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deals Deal[]

  @@index([businessName])
  @@map("businesses")
}

// Stipulation requested from a deal's buyer (docs needed to close):
// driver's license, proof of insurance/income/residence, or custom.
// Sent via SMS/email with a tokenized upload link; received is toggled
// manually until uploads auto-match.
model DealStipulation {
  id          String    @id @default(uuid())
  dealId      String    @map("deal_id")
  name        String
  instruction String?
  forBuyer    Boolean   @default(true) @map("for_buyer")
  forCoBuyer  Boolean   @default(false) @map("for_co_buyer")
  status      String    @default("pending") // pending | received
  sentVia     String?   @map("sent_via") // email | sms
  requestedAt DateTime  @default(now()) @map("requested_at")
  receivedAt  DateTime? @map("received_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_stipulations")
}

// Dealership-wide custom stip quick-picks ("Save for Future" in the
// request modal). The four standard stips live in code, not here.
model StipTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  instruction String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("stip_templates")
}

// ─── Deal Desk (Phase 4, Slice 1: retail cash) ────────────────────────
// One Deal = one attempt to sell one vehicle to one buyer. Created as a
// draft (from a won opportunity or directly), carries the out-the-door
// worksheet, and "funding" it is the single event that promotes the
// contact to customer + marks the vehicle sold.
//
// Money is Float dollars (matches Vehicle cost fields — NOT Opportunity.value
// which is legacy Int cents). Tax rates are stored per-deal so old deals
// keep the rate they were sold under; defaults are FL retail (6% state +
// 1% county surtax on the first $5,000) and must be VERIFIED WITH THE
// ACCOUNTANT before real use — nothing is hardcoded at the app layer.
model Deal {
  id         String  @id @default(uuid())
  dealNumber Int     @unique @default(autoincrement()) @map("deal_number") // display as D-1001
  status     String  @default("draft") // draft | funded | cancelled
  dealType   String  @default("retail_cash") @map("deal_type") // retail_cash now; retail_finance / wholesale / consignment in later slices

  vehicleId        String  @map("vehicle_id")
  // Retail: buyerContactId set. Wholesale: businessBuyerId set instead
  // (switching deal type swaps one for the other).
  buyerContactId   String? @map("buyer_contact_id")
  businessBuyerId  String? @map("business_buyer_id")
  coBuyerContactId String? @map("co_buyer_contact_id")
  opportunityId    String? @unique @map("opportunity_id") // won opp this deal was created from
  salesRepId       String? @map("sales_rep_id")
  lienholderPartnerId String? @map("lienholder_partner_id") // Partner (lender) on the title, set at finalize

  // ── Out-the-door worksheet ──
  // Fees / accessories / products are itemized in DealLineItem (DealerCenter-
  // style dynamic lines); only the price + tax scalars live here.
  salePrice Float @default(0) @map("sale_price")

  // ── Tax ──
  // collectTax=false → out-of-state buyer pays tax at their registration.
  collectTax       Boolean @default(true) @map("collect_tax")
  stateTaxRate     Float   @default(0.06) @map("state_tax_rate")
  countySurtaxRate Float   @default(0.01) @map("county_surtax_rate")
  surtaxCap        Float   @default(5000) @map("surtax_cap") // surtax applies to first $5,000 only
  taxAmount        Float   @default(0) @map("tax_amount") // computed server-side on save

  depositCredit Float @default(0) @map("deposit_credit") // future: fed by QBO deposit link
  otdTotal      Float @default(0) @map("otd_total") // computed server-side on save

  // ── Financing terms (outside financing; all-zero on cash deals) ──
  termMonths       Int?   @map("term_months")
  apr              Float? // percent, e.g. 4.99 — NOT a decimal
  firstPaymentDays Int    @default(30) @map("first_payment_days")

  // ── Profit-side ──
  commissions Float @default(0) // manual for now; per-rep plans later

  notes       String?
  // Set when the rep presses "Proceed with Deal" — the deal graduates from
  // the worksheet to the contract page, which becomes its home in lists.
  proceededAt DateTime? @map("proceeded_at")
  fundedAt    DateTime? @map("funded_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  buyer       Contact?     @relation("DealBuyer", fields: [buyerContactId], references: [id])
  businessBuyer Business?  @relation(fields: [businessBuyerId], references: [id])
  coBuyer     Contact?     @relation("DealCoBuyer", fields: [coBuyerContactId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  salesRep    User?        @relation("DealSalesRep", fields: [salesRepId], references: [id])
  createdBy   User?        @relation("DealCreatedBy", fields: [createdById], references: [id])
  lienholderPartner Partner? @relation("DealLienholder", fields: [lienholderPartnerId], references: [id])
  lineItems    DealLineItem[]
  trades       DealTrade[]
  stipulations DealStipulation[]

  @@index([vehicleId])
  @@index([buyerContactId])
  @@index([status])
  @@map("deals")
}

// Itemized worksheet line (DealerCenter's "⋮" dynamic boxes). Category
// groups the lines into the calculator rows; `taxable` feeds the FL math —
// dealer fees (doc) are taxable, government fees (title/reg) are not.
model DealLineItem {
  id       String  @id @default(uuid())
  dealId   String  @map("deal_id")
  category String // fee | accessory | product | insurance
  label    String
  amount   Float   @default(0) // price charged to the customer
  taxable  Boolean @default(false)
  sortOrder Int    @default(0) @map("sort_order")

  // Accessory extras (DealerCenter parity): dealer cost feeds gross profit
  // later; vendor links to the Partner list; deductFrom classifies which
  // gross the cost hits.
  cost            Float?
  itemNumber      String? @map("item_number")
  vendorPartnerId String? @map("vendor_partner_id")
  deductFrom      String? @map("deduct_from") // front_gross | back_gross

  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  vendorPartner Partner? @relation(fields: [vendorPartnerId], references: [id])

  @@index([dealId])
  @@map("deal_line_items")
}

// Trade-in on a deal — up to 4 (enforced app-side; it has happened).
// Trade vehicles are NOT inventory Vehicles yet; they're captured inline.
// FL: trade allowance reduces the taxable base (verify with accountant).
// Net trade equity = allowance − payoff; payoffs the dealer assumes are
// owed to the lienholder.
model DealTrade {
  id         String  @id @default(uuid())
  dealId     String  @map("deal_id")
  vin        String?
  year       Int?
  make       String?
  model      String?
  trim       String?
  mileage    Int?
  color      String?
  allowance  Float   @default(0) // what we credit the customer
  acv        Float   @default(0) // actual cash value (what it's really worth)
  payoff     Float   @default(0) // lien balance we assume
  lienholder String?
  notes      String?
  sortOrder  Int     @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_trades")
}

model ActivityLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  actorId    String?  @map("actor_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_log")
}

model ExternalRepair {
  id                String    @id @default(uuid())
  stockNumber       String    @map("stock_number")
  year              Int?
  make              String
  model             String
  color             String?
  vendorId          String?   @map("vendor_id")
  vendor            Vendor?   @relation(fields: [vendorId], references: [id])
  shopName          String    @map("shop_name")
  shopPhone         String?   @map("shop_phone")
  atDealership      Boolean   @default(false) @map("at_dealership")
  // Part-only repair: a component (hood, seats, wheel) goes to the vendor
  // while the CAR stays in-house — sending it must not pull the vehicle off
  // the recon board or flip its status.
  partOnly          Boolean   @default(false) @map("part_only")
  repairDescription String    @map("repair_description")
  estimatedDays     Int?      @map("estimated_days")
  sentDate          DateTime? @map("sent_date")
  // Planned send-out: a pending repair with a date the car is SUPPOSED to
  // leave — the watchlist nags when the date passes and it still hasn't.
  plannedSendDate   DateTime? @map("planned_send_date")
  expectedReturn    DateTime? @map("expected_return")
  status            String    @default("sent") // pending, sent, in_progress, ready, returned
  notes             String?
  followUps         Json      @default("[]") @map("follow_ups")
  createdById       String?   @map("created_by")
  // Set when this external install is WAITING on a part to arrive: the mission
  // is created up front (pending, partOnly) so it's visible, but stays gated
  // until the part is received. Cleared on receive → the mission goes live and
  // the "never sent" watchlist rule skips it while it's still blocked.
  blockedOnPartId   String?   @map("blocked_on_part_id")
  // Set when a RECEIVED part is sent OUT for work (e.g. upholstery) and must be
  // installed IN-HOUSE on return: marking this repair `returned` queues an
  // "Install: <part>" task onto the car's mechanic recon. Distinct from
  // installVenue:'external' (which means the outside shop installs it on the car).
  installPartId     String?   @map("install_part_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([blockedOnPartId])
  @@map("external_repairs")
}

// Per-vehicle Game Plan: the ordered master roadmap for a car (from sale
// prep master sheets). Exactly one step is "active"; completing it activates
// the next and auto-creates the admin follow-up — the system tells the admin
// what's next, not the other way around.
model VehiclePlan {
  id        String   @id @default(uuid())
  vehicleId String   @unique @map("vehicle_id")
  goal      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  steps   VehiclePlanStep[]

  @@map("vehicle_plans")
}

model VehiclePlanStep {
  id          String    @id @default(uuid())
  planId      String    @map("plan_id")
  order       Int
  title       String
  detail      String?
  status      String    @default("pending") // pending | active | done | skipped
  activatedAt DateTime? @map("activated_at")
  doneAt      DateTime? @map("done_at")

  // Operational typing — a step can stage REAL work when it activates
  // (confirm-first): kind 'task' appends to a recon stage checklist, kind
  // 'external' drafts an external repair. 'generic' stays a reminder.
  kind            String    @default("generic") // generic | task | external
  actionStage     String?   @map("action_stage") // mechanic | detailing | content | publish (kind=task)
  actionShop      String?   @map("action_shop") // shop name (kind=external)
  actionCreatedAt DateTime? @map("action_created_at") // the real work exists — never double-create

  plan VehiclePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("vehicle_plan_steps")
}

// Confirmed Morning Meeting smart-input plans — replayed to the interpreter
// as few-shot examples so it learns the dealership's phrasing over time.
model MeetingPlanExample {
  id        String   @id @default(uuid())
  text      String
  steps     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("meeting_plan_examples")
}

// Learn-as-you-use memory for the "+ Add Task" smart flow. Every confirmed
// proposal (and the shape it resolved to — including answers to the tap-choice
// clarifying questions) is saved here and replayed as few-shot on the next
// classify, so the assistant catches on to this dealership's phrasings and
// stops re-asking what it's already been told. `text` is the ORIGINAL input
// (before any answer merges); `result` is the confirmed shape.
model TaskAssessExample {
  id          String   @id @default(uuid())
  text        String
  result      Json
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("task_assess_examples")
}

model Vendor {
  id              String           @id @default(uuid())
  name            String           @unique
  phone           String?
  notes           String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  externalRepairs ExternalRepair[]

  @@map("vendors")
}

model StageConfig {
  id                String   @id @default(uuid())
  stage             String   @unique
  defaultAssigneeId String?  @map("default_assignee_id")
  defaultChecklist  Json     @default("[]") @map("default_checklist")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("stage_config")
}

model ChecklistTemplate {
  id        String   @id @default(uuid())
  stage     String
  name      String
  items     Json     @default("[]") // [{ item: string, type?: string }, ...]
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([stage, name])
  @@index([stage])
  @@map("checklist_templates")
}

model TaskApproval {
  id              String       @id @default(uuid())
  vehicleStageId  String       @map("vehicle_stage_id")
  vehicleStage    VehicleStage @relation(fields: [vehicleStageId], references: [id], onDelete: Cascade)
  taskName        String       @map("task_name")
  additionalHours Float?       @map("additional_hours")
  tasks           Json?        @default("[]")
  requestedById   String       @map("requested_by_id")
  requestedBy     User         @relation(fields: [requestedById], references: [id])
  status          String       @default("pending")
  reviewedById    String?      @map("reviewed_by_id")
  reviewedAt      DateTime?    @map("reviewed_at")
  adminNote       String?      @map("admin_note")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("task_approvals")
}

model Task {
  id            String    @id @default(uuid())
  title         String
  description   String?
  category      String    @default("content") // content, marketing, admin, operations
  status        String    @default("todo") // todo, in_progress, done
  priority      Int       @default(0) // 0=normal, 1=high, 2=urgent
  assigneeId    String?   @map("assignee_id")
  createdById   String    @map("created_by_id")
  dueDate       DateTime? @map("due_date")
  scheduledDate DateTime? @map("scheduled_date")
  completedAt   DateTime? @map("completed_at")
  sortOrder     Int       @default(0) @map("sort_order")
  subtasks      Json      @default("[]") // Array of { item: string, done: boolean }
  stockNumbers  Json      @default("[]") @map("stock_numbers") // Array of stock numbers tagged to this task
  // Mission links — a coordination task tied to real records lets the UI
  // derive live checkpoints (external logged / transport arranged / at shop)
  // instead of a flat checkbox nobody updates.
  externalRepairId   String? @map("external_repair_id")
  transportRequestId String? @map("transport_request_id")
  missionType        String? @map("mission_type") // deliver (car going out) | retrieve (bringing it back)
  selfTransport      Boolean @default(false) @map("self_transport") // we drive it ourselves — no tow needed
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User  @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId])
  @@index([status])
  @@map("tasks_board")
}

model StageTemplate {
  id        String   @id @default(uuid())
  stage     String
  name      String
  checklist Json     @default("[]")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([stage, name])
  @@map("stage_templates")
}

