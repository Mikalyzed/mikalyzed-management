model Contact {
  id             String    @id @default(uuid())
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String?
  phone          String?
  secondaryPhone String?   @map("secondary_phone")
  dateOfBirth    DateTime? @map("date_of_birth")
  contactType    String    @default("lead") @map("contact_type") // lead, customer, vendor
  address        String?
  city           String?
  state          String?
  zip            String?
  country        String?
  website        String?
  timezone       String?
  source         String    @default("other")
  tags           String[]  @default([])
  notes          String?
  createdById    String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // --- Identity (matches DealerCenter Buyer Info section)
  salutation         String? // Mr. / Mrs. / Ms. / Dr.
  middleName         String? @map("middle_name")
  nameSuffix         String? @map("name_suffix") // Jr. / Sr. / II / III / IV
  nickname           String?
  gender             String? // Male / Female / Other / Prefer not to say
  ssn                String? // plain v1; encryption deferred to security review
  idType             String? @map("id_type") // Driver License / State ID / Passport / etc.
  idState            String? @map("id_state")
  idNo               String? @map("id_no")
  idIssuedDate       DateTime? @map("id_issued_date")
  idExpirationDate   DateTime? @map("id_expiration_date")
  homePhone          String? @map("home_phone")
  workPhone          String? @map("work_phone")

  // --- Residence (DealerCenter applicant parity; FL title wants county)
  county                String?
  residenceType         String? @map("residence_type") // Own / Rent / Family / Other
  rentMortgage          Float?  @map("rent_mortgage") // monthly payment
  lengthAtAddressYears  Int?    @map("length_at_address_years")
  lengthAtAddressMonths Int?    @map("length_at_address_months")

  // --- Previous address (credit apps want it when current < 2 years)
  prevStreet         String? @map("prev_street")
  prevCity           String? @map("prev_city")
  prevState          String? @map("prev_state")
  prevZip            String? @map("prev_zip")
  prevCounty         String? @map("prev_county")
  prevResidenceType  String? @map("prev_residence_type")
  prevRentMortgage   Float?  @map("prev_rent_mortgage")
  prevLengthYears    Int?    @map("prev_length_years")
  prevLengthMonths   Int?    @map("prev_length_months")

  // --- Sales pipeline / lead funnel
  leadType        String?  @map("lead_type") // Walk-in / Internet / Phone / Referral / Trade-In / Repeat / Other
  leadSource      String?  @map("lead_source") // marketing channel (Website / Facebook / Instagram / Google / etc.)
  inquiryType     String?  @map("inquiry_type") // Sell us your car / Vehicle storage / Reserved vehicle / Make offer / Apply for financing / Contact us — auto-populated when a lead lands from a specific website form
  customerStatus  String?  @map("customer_status") // New / Contacted / Hot / Warm / Cold / Negotiating / Sold / Lost / Inactive
  cashDown        Float?   @map("cash_down")
  salesRepId      String?  @map("sales_rep_id") // User.id of assigned rep (no FK constraint yet)
  isInShowroom    Boolean  @default(false) @map("is_in_showroom")

  // --- Employment (primary)
  employmentType        String? @map("employment_type") // Employed / Self-Employed / Retired / ...
  employerName          String? @map("employer_name")
  employerPhone         String? @map("employer_phone")
  employerAddress       String? @map("employer_address")
  employerYears         Int?    @map("employer_years")
  employerMonths        Int?    @map("employer_months")
  incomeType            String? @map("income_type") // Salary / Hourly / Commission / ...
  employerMonthlyIncome Float?  @map("employer_monthly_income")

  // --- Employment (secondary — DealerCenter has two blocks)
  employment2Type         String? @map("employment2_type")
  employer2Name           String? @map("employer2_name")
  employer2Phone          String? @map("employer2_phone")
  employer2Years          Int?    @map("employer2_years")
  employer2Months         Int?    @map("employer2_months")
  income2Type             String? @map("income2_type")
  employer2MonthlyIncome  Float?  @map("employer2_monthly_income")

  // --- Referrer (who referred this contact)
  referrerName      String? @map("referrer_name") // free-text fallback when no internal contact match
  referrerPhone     String? @map("referrer_phone")
  referrerEmail     String? @map("referrer_email")
  referrerAddress   String? @map("referrer_address")
  referrerContactId String? @map("referrer_contact_id") // FK-ish reference to another Contact

  // --- Co-buyer (second person on the deal — spouse / business partner)
  // Stored as a soft FK to another Contact; no schema-level constraint so
  // detaching a co-buyer doesn't cascade.  GET endpoint joins this in.
  coBuyerContactId  String? @map("co_buyer_contact_id")
  // Relationship of the co-buyer to THIS buyer (Spouse / Parent / …).
  // A property of the pairing, so it lives on the buyer's record — the
  // co-buyer's own contact stays untouched.
  coBuyerRelationship String? @map("co_buyer_relationship")

  createdBy        User?             @relation("ContactCreatedBy", fields: [createdById], references: [id])
  opportunities    Opportunity[]
  vehicleInterests VehicleInterest[]
  messages         Message[]
  uploadLinks      UploadLink[]
  calls            Call[]
  dealsAsBuyer     Deal[]            @relation("DealBuyer")
  dealsAsCoBuyer   Deal[]            @relation("DealCoBuyer")

  @@index([email])
  @@index([phone])
  @@index([customerStatus])
  @@index([leadType])
  @@index([referrerContactId])
  @@index([salesRepId])
  @@map("contacts")
}

model EmailSubscription {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  userEmail      String   @map("user_email") // M365 mailbox address
  subscriptionId String   @unique @map("subscription_id") // Graph subscription id
  clientState    String   @map("client_state") // shared secret to validate notifications
  resource       String // e.g. users/{email}/mailFolders('inbox')/messages
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userEmail])
  @@index([expiresAt])
  @@map("email_subscriptions")
}

model Call {
  id                       String    @id @default(uuid())
  contactId                String?   @map("contact_id")
  direction                String // outbound, inbound
  fromNumber               String    @map("from_number") // E.164
  toNumber                 String    @map("to_number") // E.164
  twilioCallSid            String    @unique @map("twilio_call_sid")
  status                   String    @default("initiated") // initiated, ringing, in-progress, completed, busy, failed, no-answer, canceled, voicemail
  startedAt                DateTime  @default(now()) @map("started_at")
  answeredAt               DateTime? @map("answered_at")
  endedAt                  DateTime? @map("ended_at")
  durationSeconds          Int?      @map("duration_seconds")
  recordingSid             String?   @map("recording_sid")
  recordingUrl             String?   @map("recording_url")
  recordingDurationSeconds Int?      @map("recording_duration_seconds")
  transcription            String? // Full transcript (when ready)
  transcriptionStatus      String?   @map("transcription_status") // pending, completed, failed
  voicemail                Boolean   @default(false) // true if call went to voicemail
  ownerId                  String?   @map("owner_id") // rep who placed/received the call
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   User?    @relation(fields: [ownerId], references: [id])

  @@index([contactId, startedAt])
  @@index([twilioCallSid])
  @@map("calls")
}

model UploadLink {
  id          String   @id @default(uuid())
  token       String   @unique
  contactId   String   @map("contact_id")
  createdById String   @map("created_by_id")
  expiresAt   DateTime @map("expires_at")
