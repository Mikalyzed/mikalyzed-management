model Opportunity {
  id              String    @id @default(uuid())
  contactId       String    @map("contact_id")
  pipelineId      String    @map("pipeline_id")
  stageId         String    @map("stage_id")
  assigneeId      String?   @map("assignee_id")
  vehicleId       String?   @map("vehicle_id")
  vehicleInterest String?   @map("vehicle_interest")
  source          String    @default("other")
  sourceDetail    String?   @map("source_detail")
  value           Int? // deal value in cents
  lostReason      String?   @map("lost_reason")
  lostNotes       String?   @map("lost_notes")
  appointmentDate DateTime? @map("appointment_date")
  firstContactAt  DateTime? @map("first_contact_at")
  wonAt           DateTime? @map("won_at")
  lostAt          DateTime? @map("lost_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  contact         Contact           @relation(fields: [contactId], references: [id])
  pipeline        Pipeline          @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage     @relation(fields: [stageId], references: [id])
  assignee        User?             @relation("OpportunityAssignee", fields: [assigneeId], references: [id])
  vehicle         Vehicle?          @relation("OpportunityVehicle", fields: [vehicleId], references: [id])
  tasks           OpportunityTask[]
  notes           OpportunityNote[]
  activities      ActivityEvent[]
  dispositionLogs DispositionLog[]
  deal            Deal?

  @@index([contactId])
  @@index([pipelineId, stageId])
  @@index([assigneeId])
  @@index([vehicleId])
  @@map("opportunities")
}

model OpportunityNote {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  body          String
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("NoteCreatedBy", fields: [createdById], references: [id])

  @@index([opportunityId])
  @@map("opportunity_notes")
}

model OpportunityTask {
  id            String    @id @default(uuid())
  opportunityId String    @map("opportunity_id")
  title         String
  dueDate       DateTime? @map("due_date")
  assigneeId    String?   @map("assignee_id")
  status        String    @default("pending") // pending, completed
  completedAt   DateTime? @map("completed_at")
  notes         String?
  createdById   String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("OppTaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User?       @relation("OppTaskCreatedBy", fields: [createdById], references: [id])

  @@index([opportunityId])
  @@index([assigneeId])
  @@map("opportunity_tasks")
}

model ActivityEvent {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  type          String // lead_created, stage_changed, assigned, note_added, task_created, task_completed, call_logged, sms_sent, sms_received, email_sent, appointment_set
  description   String
  metadata      Json?
  actorId       String?  @map("actor_id")
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor       User?       @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([opportunityId, createdAt])
  @@map("activity_events")
}

model VehicleInterest {
  id        String   @id @default(uuid())
  contactId String   @map("contact_id")
  vehicleId String?  @map("vehicle_id")
  make      String?
  model     String?
  yearMin   Int?     @map("year_min")
  yearMax   Int?     @map("year_max")
  priceMax  Int?     @map("price_max")
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation("VehicleInterestVehicle", fields: [vehicleId], references: [id])

  @@index([contactId])
  @@index([make, model])
  @@map("vehicle_interests")
}

model RoundRobinState {
  id             String   @id @default(uuid())
  pipelineId     String   @unique @map("pipeline_id")
  lastAssignedId String   @map("last_assigned_id")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("round_robin_state")
}

model RoundRobinWeight {
  id         String @id @default(uuid())
  pipelineId String @map("pipeline_id")
  userId     String @map("user_id")
  weight     Int    @default(1) // e.g., 2 means gets 2x leads

  user User @relation(fields: [userId], references: [id])

  @@unique([pipelineId, userId])
  @@map("round_robin_weights")
}

model Disposition {
  id              String  @id @default(uuid())
  name            String
  pipelineId      String? @map("pipeline_id") // null = global
  moveToStageId   String? @map("move_to_stage_id") // optional auto-move
  followUpMinutes Int?    @map("follow_up_minutes") // optional auto follow-up
  sortOrder       Int     @default(0) @map("sort_order")
  isActive        Boolean @default(true) @map("is_active")
  color           String? // optional color for UI

  pipeline    Pipeline?              @relation(fields: [pipelineId], references: [id])
  moveToStage PipelineStage?         @relation(fields: [moveToStageId], references: [id])
  logs        DispositionLog[]
  rules       DispositionStageRule[]

  @@map("dispositions")
}

model DispositionStageRule {
  id             String   @id @default(uuid())
  pipelineId     String   @map("pipeline_id")
  dispositionId  String   @map("disposition_id")
  currentStageId String?  @map("current_stage_id") // null = matches any non-final stage
  moveToStageId  String   @map("move_to_stage_id")
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pipeline     Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  disposition  Disposition    @relation(fields: [dispositionId], references: [id], onDelete: Cascade)
  currentStage PipelineStage? @relation("RuleCurrentStage", fields: [currentStageId], references: [id])
  moveToStage  PipelineStage  @relation("RuleMoveToStage", fields: [moveToStageId], references: [id])

  @@unique([pipelineId, dispositionId, currentStageId])
  @@index([dispositionId])
  @@index([pipelineId])
  @@map("disposition_stage_rules")
}

model DispositionLog {
  id            String    @id @default(uuid())
  opportunityId String    @map("opportunity_id")
  dispositionId String    @map("disposition_id")
  userId        String    @map("user_id")
  notes         String?
  followUpAt    DateTime? @map("follow_up_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  disposition Disposition @relation(fields: [dispositionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([opportunityId])
  @@index([userId])
  @@map("disposition_logs")
}

model LeadSource {
  id        String  @id @default(uuid())
  name      String  @unique // display name
  key       String  @unique // internal key like "autotrader"
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("lead_sources")
}

// ═══ Messaging ═══

model Message {
  id                     String    @id @default(uuid())
  contactId              String    @map("contact_id")
  direction              String // inbound, outbound
  channel                String    @default("sms") // sms, email, instagram, whatsapp
  body                   String
  subject                String? // emails only
  mediaUrl               String?   @map("media_url") // original Twilio URL (auth-required) — used as ingest source
  mediaContentType       String?   @map("media_content_type") // e.g. image/jpeg, video/mp4
  emailConversationId    String?   @map("email_conversation_id") // Graph conversationId for email threading
  cloudinaryPublicId     String?   @map("cloudinary_public_id") // Cloudinary public_id once uploaded — UI prefers this
  cloudinaryResourceType String?   @map("cloudinary_resource_type") // 'image' | 'video' — needed for URL building
  r2Key                  String?   @map("r2_key") // R2 object key for direct customer uploads (any size)
  status                 String    @default("sent") // sent, delivered, failed, received
  externalId             String?   @map("external_id") // Twilio SID or external message ID
  senderId               String?   @map("sender_id") // user who sent (null for inbound)
  readAt                 DateTime? @map("read_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sender  User?   @relation("MessageSender", fields: [senderId], references: [id])

  @@index([contactId, createdAt])
  @@index([externalId])
  @@map("messages")
}

// ═══ Inventory ═══

model InventoryVehicle {
  id            String    @id @default(uuid())
  stockNumber   String    @unique @map("stock_number")
  vin           String?
  vehicleInfo   String    @map("vehicle_info") // full description from DealerCenter
  year          Int?
  make          String
  model         String
  trim          String?
  color         String?
  mileage       Int?
  location      String?
  askingPrice   Float?    @map("asking_price")
  vehicleCost   Float?    @map("vehicle_cost")
  purchaseType  String?   @map("purchase_type") // FLOORING, CONSIGNMENT, TRADE-IN
  purchasedFrom String?   @map("purchased_from")
  titleStatus   String?   @map("title_status") // RECEIVED, NOT RECEIVED
  dateInStock   DateTime? @map("date_in_stock")
  status        String    @default("in_stock") @map("status") // in_stock, sold, in_recon
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([make, model])
  @@map("inventory_vehicles")
}

// ═══ Porter ═══

model PorterEntry {
  id           String    @id @default(uuid())
  vin6         String    @map("vin6") // last 6 of VIN
  carName      String    @map("car_name") // e.g. "Black Camaro"
  wipeDown     Boolean   @default(false) @map("wipe_down")
  tirePressure Boolean   @default(false) @map("tire_pressure")
  matUnderCar  Boolean   @default(false) @map("mat_under_car")
  charger      Boolean   @default(false)
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  completedAt  DateTime? @map("completed_at")
  date         DateTime  @default(now()) // which day this entry is for
  porterId     String?   @map("porter_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  porter User? @relation("PorterEntries", fields: [porterId], references: [id])

  @@index([date])
  @@index([porterId])
  @@map("porter_entries")
}

model PorterTask {
  id           String    @id @default(uuid())
  title        String
  notes        String?
  assignedToId String?   @map("assigned_to_id")
  status       String    @default("pending") // pending, in_progress, completed
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  assignedTo User? @relation("PorterTaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User? @relation("PorterTaskCreator", fields: [createdById], references: [id])

  @@index([assignedToId])
  @@map("porter_tasks")
}

// ═══ Calendar ═══

model CalendarItem {
  id          String    @id @default(uuid())
  title       String
  type        String    @default("errand")
  date        DateTime
  endDate     DateTime? @map("end_date")
  allDay      Boolean   @default(false) @map("all_day")
  location    String?
  notes       String?
  status      String    @default("scheduled")
  vehicleId   String?   @map("vehicle_id")
  eventId     String?   @map("event_id")
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  vehicle   Vehicle?           @relation(fields: [vehicleId], references: [id])
  event     Event?             @relation(fields: [eventId], references: [id])
  createdBy User               @relation("CalendarCreatedBy", fields: [createdById], references: [id])
  assignees CalendarAssignee[]

  @@index([date])
  @@index([status])
  @@index([vehicleId])
  @@index([eventId])
  @@map("calendar_items")
}

model CalendarAssignee {
  id             String   @id @default(uuid())
  calendarItemId String   @map("calendar_item_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  calendarItem CalendarItem @relation(fields: [calendarItemId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([calendarItemId, userId])
  @@map("calendar_assignees")
}

// ═══ Events ═══

model Event {
  id          String    @id @default(uuid())
  name        String
  type        String    @default("dealership_event")
  date        DateTime
  endDate     DateTime? @map("end_date")
  location    String?
  description String?
  status      String    @default("draft")
  ownerId     String    @map("owner_id")
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner         User           @relation("EventOwner", fields: [ownerId], references: [id])
  createdBy     User           @relation("EventCreatedBy", fields: [createdById], references: [id])
  sections      EventSection[]
  calendarItems CalendarItem[]

  @@index([date])
  @@index([status])
  @@map("events")
}

model EventSection {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tasks EventTask[]

  @@index([eventId])
  @@map("event_sections")
}

model EventTask {
  id          String    @id @default(uuid())
  sectionId   String    @map("section_id")
  title       String
  assigneeId  String?   @map("assignee_id")
  dueDate     DateTime? @map("due_date")
  priority    String    @default("normal")
  status      String    @default("pending")
  notes       String?
  sortOrder   Int       @default(0) @map("sort_order")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  section  EventSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignee User?        @relation("EventTaskAssignee", fields: [assigneeId], references: [id])

  @@index([sectionId])
  @@index([assigneeId])
  @@index([status])
  @@map("event_tasks")
}

model WeeklyPlanSnapshot {
  id        String   @id @default(uuid())
  weekStart DateTime @map("week_start")
  createdAt DateTime @default(now()) @map("created_at")
  entries   Json     @default("[]") // Array of { vehicleStageId, vehicleId, stockNumber, year, make, model, color, day, estimatedHours, assigneeName }

  @@unique([weekStart])
  @@map("weekly_plan_snapshots")
}

/// Instagram accounts connected to this app via OAuth (Instagram Business Login flow).
/// Created when a user clicks "Connect Instagram Account" in Settings and authorizes via Meta.
model ConnectedInstagramAccount {
  id                String    @id @default(uuid())
  igUserId          String    @unique @map("ig_user_id") // Instagram-scoped user ID
  username          String
  name              String?
  profilePictureUrl String?   @map("profile_picture_url")
  accessToken       String    @map("access_token") // long-lived (60 days)
  tokenExpiresAt    DateTime? @map("token_expires_at")
  connectedAt       DateTime  @default(now()) @map("connected_at")
  connectedById     String    @map("connected_by_id")
  connectedBy       User      @relation(fields: [connectedById], references: [id])

  @@index([connectedById])
  @@map("connected_instagram_accounts")
}

// Phase 0.A — audit trail mapping legacy Vehicle + InventoryVehicle rows to canonical Vehicle.
// Populated by the Sub-phase 0.B backfill script; queried by /api/vehicles/legacy/[oldId] redirect.
// One row per (old_vehicle_id, old_inventory_vehicle_id) pair OR per orphan side.
model VehicleMigrationMap {
  id                    String   @id @default(uuid())
  oldVehicleId          String?  @map("old_vehicle_id") // null = orphan IV (no recon match)
  oldInventoryVehicleId String?  @map("old_inventory_vehicle_id") // null = orphan V (no IV match)
  canonicalVehicleId    String   @map("canonical_vehicle_id")
  matchMethod           String   @map("match_method") // "stock_number" | "manual_review" | "orphan_iv_created" | "orphan_v_left_alone"
  matchConfidence       String   @map("match_confidence") // "high" | "low" | "manual"
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([canonicalVehicleId])
  @@index([oldVehicleId])
  @@index([oldInventoryVehicleId])
  @@map("vehicle_migration_map")
}
